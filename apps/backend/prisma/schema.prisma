generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  nationalId String   @unique
  password   String
  role       Role
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userDoc    UserDoc?

  // Relations based on role
  userHOAs                   UserHOA[] // Many-to-many relationship with HOAs
  postedJobs                 Job[]                  @relation("JobLeader") // Optional - can be empty if no jobs posted
  createdJobs                Job[]                  @relation("JobCreator") // Jobs created by this user (home owners)
  reviewedCompletionRequests JobCompletionRequest[] @relation("JobCompletionReviewer") // Completion requests reviewed by this user

  // Chat relations
  communityMemberships CommunityMember[]
  chatParticipants     ChatParticipant[]
  sentMessages         Message[]
  createdPolls         Poll[]
  pollVotes            PollVote[]
}

model UserHOA {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hoaId     String
  hoa       Hoa      @relation(fields: [hoaId], references: [id])
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, hoaId]) // One relationship per user per HOA
}

model Hoa {
  id        String     @id @default(uuid())
  name      Json // HOA name with translations {en: string, ar: string}
  hoaNumber String     @unique // HOA number - unique across system
  address   Json // Full address with translations {en: string, ar: string}
  city      Json // City with translations {en: string, ar: string}
  state     Json? // State with translations {en: string, ar: string}
  userHOAs  UserHOA[] // Many-to-many relationship with users
  jobs      Job[] // Jobs posted for this HOA
  community Community? // One community per HOA
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model NafathVerification {
  id         String                   @id @default(uuid())
  nationalId String
  // user       User?                    @relation(fields: [nationalId], references: [nationalId])
  status     NafathVerificationStatus @default(WAITING)
  details    Json?
  transId    String?
  random     String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

enum NafathVerificationStatus {
  WAITING
  EXPIRED
  REJECTED
  COMPLETED
}

model TempNafathWebhook {
  id        String   @id @default(uuid())
  response  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

