          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Approved. Maintenance team will be sent tomorrow.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ticket/{{ticketId}}/approve?lang=en",
          "host": ["{{baseUrl}}"],
          "path": ["ticket", "{{ticketId}}", "approve"],
          "query": [
            {
              "key": "lang",
              "value": "en"
            }
          ]
        }
      }
    },
    {
      "name": "12. Reject Ticket (Leader)",
      "request": {
