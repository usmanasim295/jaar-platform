{
  "name": "jar-monorepo",
  "version": "1.0.0",
  "description": "Jar - Full Stack Monorepo with Backend, Frontend, and Mobile App",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!@jar/docs && changeset publish",
    "backend:dev": "turbo run dev --filter=@jar/backend",
    "frontend:dev": "turbo run dev --filter=@jar/frontend",
    "mobile:dev": "turbo run dev --filter=@jar/mobile",
    "backend:build": "turbo run build --filter=@jar/backend",
    "frontend:build": "turbo run build --filter=@jar/frontend",
    "mobile:build": "turbo run build --filter=@jar/mobile"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@turbo/gen": "^1.12.4",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fss88/Jar.git"
  },
  "keywords": [
    "monorepo",
    "fullstack",
    "nodejs",
    "nextjs",
    "react-native",
    "typescript"
  ],
  "author": "Jar Team",
  "license": "MIT"
}
